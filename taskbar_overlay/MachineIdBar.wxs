<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Machine ID Bar"
           Manufacturer="MachineIdBar"
           Version="1.0.0.0"
           UpgradeCode="b8f3a2e1-7c4d-4a9e-b6f1-3e5a7c9d2b8e"
           Language="1033"
           Codepage="1252"
           InstallerVersion="500"
           Scope="perMachine">

    <SummaryInformation Description="Machine ID Bar - Taskbar overlay for RDP session identification" />

    <Media Id="1" Cabinet="MachineIdBar.cab" EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="MachineIdBar">
        <Component Id="MainExe" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567890">
          <File Id="MachineIdBarExe" Source="MachineIdBar.exe" KeyPath="yes" />
          <RemoveFolder Id="RemoveInstallDir" Directory="INSTALLDIR" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Complete" Title="Machine ID Bar" Level="1">
      <ComponentRef Id="MainExe" />
    </Feature>

    <!--
      Impersonated deferred custom actions.
      perMachine MSI runs as SYSTEM, but -i/-u need the current user's
      %LOCALAPPDATA% and %APPDATA%, so we impersonate.

      Pattern: Type 51 (SetProperty) stores the exe path in a property
      during the immediate phase, then Type 50 (deferred) executes it
      with ExeCommand arguments.
    -->

    <!-- Install: MachineIdBar.exe -i -->
    <CustomAction Id="SetRunInstall"
                  Property="RunInstallDeferred"
                  Value="[INSTALLDIR]MachineIdBar.exe" />
    <CustomAction Id="RunInstallDeferred"
                  Property="RunInstallDeferred"
                  ExeCommand="-i -n"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />

    <!-- Uninstall: MachineIdBar.exe -u -->
    <CustomAction Id="SetRunUninstall"
                  Property="RunUninstallDeferred"
                  Value="[INSTALLDIR]MachineIdBar.exe" />
    <CustomAction Id="RunUninstallDeferred"
                  Property="RunUninstallDeferred"
                  ExeCommand="-u -n"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Install: set property, then run after files are in place -->
      <Custom Action="SetRunInstall" After="InstallInitialize" Condition="NOT Installed" />
      <Custom Action="RunInstallDeferred" After="InstallFiles" Condition="NOT Installed" />

      <!-- Uninstall: set property, then run before files are removed (exe must still exist) -->
      <Custom Action="SetRunUninstall" After="InstallInitialize" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RunUninstallDeferred" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
